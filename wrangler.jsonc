{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Worker de TESTE. O de produção ("upload-de-roteiros") não usa este arquivo.
  "name": "upload-de-roteiros-teste",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  // Variáveis definidas no painel não são apagadas a cada deploy.
  "keep_vars": true,

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Só /api/* executa código; o resto é arquivo estático (não gasta CPU).
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true }

  // Segredos (painel → Settings → Variables and Secrets, ou `wrangler secret put`):
  //   N8N_WEBHOOK_URL, N8N_HEALTHCHECK_URL
  //   opcionais: N8N_AUTH_HEADER_NAME, N8N_AUTH_HEADER_VALUE,
  //              N8N_ACCESS_CLIENT_ID, N8N_ACCESS_CLIENT_SECRET,
  //              ACCESS_TEAM_DOMAIN, ACCESS_AUD
}
